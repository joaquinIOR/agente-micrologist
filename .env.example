# Copiar a .env y completar. Formato del modelo: proveedor:modelo (lo resuelve init_chat_model de LangChain).
# Key gratuita de Groq: https://console.groq.com/keys
LLM_MODELO=groq:openai/gpt-oss-120b
GROQ_API_KEY=

# Otro proveedor: instalar su paquete (ej. pip install langchain-google-genai) y usar su key.
# LLM_MODELO=google_genai:gemini-2.5-flash
# GOOGLE_API_KEY=
