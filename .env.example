# Copiar a .env y completar. Formato del modelo: proveedor:modelo (lo resuelve init_chat_model de LangChain).
# Key gratuita de Gemini: https://aistudio.google.com/apikey
LLM_MODELO=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=

# Respaldo automático: si el modelo principal falla (p. ej. cuota diaria agotada), el agente sigue con este.
# Key gratuita de Groq: https://console.groq.com/keys. Sin key, el agente funciona igual pero sin respaldo.
LLM_RESPALDO=groq:openai/gpt-oss-120b
GROQ_API_KEY=
